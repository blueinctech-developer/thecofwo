# ---------------------------------------------------------------
# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables (see docs/DEPLOYMENT.md).
# ---------------------------------------------------------------

# Postgres connection. Locally: run `npm run db` and use the value below.
# On Vercel the Neon integration adds DATABASE_URL automatically.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54341/cofwo

# Long random string used to sign admin logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# The ministry's timezone. Dates and event times on the website are shown in this zone.
# Use an IANA name, e.g. Africa/Lagos, Europe/London, America/New_York.
SITE_TIMEZONE=Africa/Lagos

# The public address of the site (no trailing slash).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob storage for uploaded photos. Leave empty locally (files go to ./media).
# On Vercel, connecting a Blob store adds this automatically.
BLOB_READ_WRITE_TOKEN=

# Optional: email notifications for contact messages and signups (https://resend.com).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@thecofwo.org
EMAIL_FROM_NAME=COFWO Website

# Optional, local development only: `npx payload run src/seed/local-admin.ts` creates this admin.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
