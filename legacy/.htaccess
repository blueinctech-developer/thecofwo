# ==========================================================================
# thecofwo.org – Apache / Hostinger / cPanel configuration
# Static site: no PHP, no database. Keep this file in the site's root folder.
# ==========================================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# --- 1. One canonical address: https, no "www" -------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://thecofwo.org/$1 [R=301,L]

# --- 2. Old WordPress URLs that moved (301 = permanent) ---------------------
RewriteRule ^contact-us-2/?$ /contact-us/ [R=301,L]
RewriteRule ^(blog-standard|blog-list)/?$ /cofwo-blog/ [R=301,L]
RewriteRule ^author/the-cofwo/?$ /cofwo-blog/ [R=301,L]
RewriteRule ^category/faith-2/feed/?$ /feed.xml [R=301,L]
RewriteRule ^feed/?$ /feed.xml [R=301,L]
RewriteRule ^(wp-sitemap.*|sitemap_index)\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(its-your-time-to-shine|faith-vision-and-victory-living-a-victorious-christian-life|understanding-gods-purpose-for-your-life-a-guide-to-divine-direction)/feed/?$ /$1/ [R=301,L]

# Old image addresses (Google Images, shared links) -> new local copies
RewriteRule ^wp-content/uploads/2026/04/(FB_IMG_[0-9]+(-1)?)(-[0-9]+x[0-9]+)?\.jpe?g$ /assets/images/gallery/$1.jpg [R=301,L,NC]
RewriteRule ^wp-content/uploads/2026/0[34]/(FB_IMG_[0-9]+|swi-57[0-9]+-scaled-1|slide-2cofwo|cofwopst2?|midcrowd)(-[0-9]+x[0-9]+)?\.jpe?g$ /assets/images/$1.jpg [R=301,L,NC]
RewriteRule ^wp-content/uploads/2026/04/Slider(-[0-9]+x[0-9]+)?\.jpe?g$ /assets/images/Slider.jpg [R=301,L,NC]
RewriteRule ^wp-content/uploads/2026/03/about-second(-[0-9]+x[0-9]+)?\.webp$ /assets/images/about-second.jpg [R=301,L,NC]
RewriteRule ^wp-content/uploads/2026/0[34]/(cofwo-logo-white|cofwo-logo|cofwo-logomark)(-[0-9]+x[0-9]+)?\.png$ /assets/images/$1.png [R=301,L,NC]

# --- 3. Theme demo pages that were never COFWO content (410 = gone) ---------
RewriteRule ^typography/?$ - [G,L]
RewriteRule ^cart/?$ - [G,L]
RewriteRule ^checkout/?$ - [G,L]
RewriteRule ^my-account/?$ - [G,L]
RewriteRule ^wishlist-page/?$ - [G,L]
RewriteRule ^shop/?$ - [G,L]
RewriteRule ^online-conference/?$ - [G,L]
RewriteRule ^creative-conference/?$ - [G,L]
RewriteRule ^multi-event/?$ - [G,L]
RewriteRule ^online-tickets/?$ - [G,L]
RewriteRule ^gaming-comics/?$ - [G,L]
RewriteRule ^fashion-event/?$ - [G,L]
RewriteRule ^faqs/?$ - [G,L]
RewriteRule ^pricing/?$ - [G,L]
RewriteRule ^newsletter-popups/?$ - [G,L]
RewriteRule ^service-plus/?$ - [G,L]
RewriteRule ^food-festival/?$ - [G,L]
RewriteRule ^education-conference/?$ - [G,L]
RewriteRule ^music-conference/?$ - [G,L]
RewriteRule ^concert/?$ - [G,L]
RewriteRule ^art-event/?$ - [G,L]
RewriteRule ^what-we-offer/?$ - [G,L]
RewriteRule ^speakers/?$ - [G,L]
RewriteRule ^tickets-checkout/?$ - [G,L]
RewriteRule ^tickets-order/?$ - [G,L]
RewriteRule ^city-events/?$ - [G,L]
RewriteRule ^business-forum-2/?$ - [G,L]
RewriteRule ^product/ - [G,L]
RewriteRule ^layouts/ - [G,L]
RewriteRule ^portfolio/ - [G,L]
RewriteRule ^services/ - [G,L]
RewriteRule ^team/ - [G,L]
RewriteRule ^event/ - [G,L]
RewriteRule ^events/ - [G,L]
RewriteRule ^testimonials_group/ - [G,L]
RewriteRule ^tribe_events_cat/ - [G,L]
RewriteRule ^events-category/ - [G,L]
RewriteRule ^wp-(admin|login\.php|json|includes) - [G,L]

# --- 4. Add a trailing slash to folder pages (/about-us -> /about-us/).
#        Kept after the rules above so there are no redirect chains.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://thecofwo.org/$1/ [R=301,L]

</IfModule>

# --- 5. Security headers ---------------------------------------------------
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# --- 6. Caching: images/CSS/JS for a month, pages always fresh -------------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType text/css "access plus 1 week"
ExpiresByType application/javascript "access plus 1 week"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml text/xml application/rss+xml image/svg+xml
</IfModule>
